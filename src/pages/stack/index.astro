---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHead from "../../components/SectionHead.astro";
import BomTableFull from "../../components/BomTableFull.astro";

const rows = (await getCollection("stack")).map((r) => r.data);

const familyMeta = [
  { code: "FPGA" as const, title: "FPGA & logique programmable" },
  { code: "EMB" as const, title: "Firmware & embarqué" },
  { code: "PROTO" as const, title: "Protocoles implémentés" },
  { code: "ELEC" as const, title: "Électronique & carte" },
  { code: "BCK" as const, title: "Backend web" },
  { code: "FRT" as const, title: "Frontend web" },
  { code: "INF" as const, title: "Infra & CI/CD" },
  { code: "MTH" as const, title: "Méthode & qualité" },
];

const families = familyMeta.map((f) => {
  const famRows = rows.filter((r) => r.family === f.code);
  const minSince = Math.min(...famRows.map((r) => r.since));
  return {
    code: f.code,
    title: f.title,
    meta: `${famRows.length} référence${famRows.length > 1 ? "s" : ""} · depuis ${minSince}`,
  };
});

const currentYear = new Date().getFullYear();
const oldestSince = Math.min(...rows.map((r) => r.since));
const oldestItem = rows.find((r) => r.since === oldestSince);
const maxYears = currentYear - oldestSince;
const linkedFichesCount = new Set(rows.flatMap((r) => r.usages.map((u) => u.href).filter(Boolean))).size;
---

<BaseLayout
  title="Stack technique — BOM · Julien Aupart"
  active={5}
  container="wide"
  stripFields={[
    { label: "FICHE", value: "JA-ENG / STACK" },
    { label: "RÉV", value: "1.0 — 2026.05" },
    { label: "DOC", value: "BOM / BILL OF MATERIALS" },
    { label: "PAGE", value: "05 / 08" },
  ]}
>
  <div class="container">
    <header class="hero">
      <div class="hero-left">
        <span class="field-label">Document</span>
        <h1>Bill of <span class="em">materials</span><span class="dot">.</span></h1>
        <div class="role">
          La stack que j'opère — exprimée comme la nomenclature d'un produit.
          Chaque ligne porte une référence, des composants concrets, une maturité.
        </div>
        <p class="lead">
          Aucun graphique de progression cliché, aucune barre « expert » à 87 %.
          Je liste <em class="hl">ce qui tourne en production aujourd'hui</em>, depuis combien
          de temps, et à quel niveau je le maîtrise. Le reste — ce que je n'ai
          qu'effleuré, ce que je refuse de prendre — est documenté en bas de page.
        </p>
      </div>

      <div class="hero-right">
        <span class="field-label">Métadonnées</span>
        <div class="meta">
          <div class="row"><span class="k">Document</span><span class="v">BOM-STACK / v 1.0</span></div>
          <div class="row"><span class="k">Émis</span><span class="v">2026.05.12</span></div>
          <div class="row"><span class="k">Périmètre</span><span class="v">Stack technique opérée</span></div>
          <div class="row"><span class="k">Lignes</span><span class="v">{rows.length} références · {families.length} familles</span></div>
          <div class="row"><span class="k">Échelle maturité</span><span class="v">5 barres (notions → autorité)</span></div>
          <div class="row"><span class="k">Validité</span><span class="v accent">en production <span class="badge">2026 actif</span></span></div>
          <div class="row"><span class="k">Rév. suivante</span><span class="v">trimestrielle</span></div>
        </div>
      </div>
    </header>

    <div class="kpis">
      <div class="kpi">
        <span class="k">Références</span>
        <span class="v">{rows.length}<span class="u"> lignes</span></span>
        <span class="sub">une technologie nommée par ligne</span>
      </div>
      <div class="kpi">
        <span class="k">Familles</span>
        <span class="v">{families.length}<span class="u"> · {families.map((f) => f.code).join(" · ")}</span></span>
        <span class="sub">du silicium à la méthode</span>
      </div>
      <div class="kpi">
        <span class="k">Ancienneté max.</span>
        <span class="v accent">{maxYears}<span class="u"> ans</span></span>
        <span class="sub">{oldestItem?.detail} — depuis {oldestSince}</span>
      </div>
      <div class="kpi">
        <span class="k">Fiches liées</span>
        <span class="v">{linkedFichesCount}<span class="u"> projets / rôles</span></span>
        <span class="sub">chaque référence pointe vers une preuve</span>
      </div>
    </div>

    <section class="block" id="bom" style="padding-top: 56px;">
      <SectionHead num="§ 01 — Matrice" title="Stack opérée, ligne par ligne." kicker="vue ingénieur, triable, exhaustive" />
      <BomTableFull rows={rows} families={families} />
    </section>

    <section class="block" id="out">
      <SectionHead num="§ 02 — Hors-périmètre" title="Ce que la BOM ne couvre pas." kicker="honnêteté avant compétence affichée" />
      <div class="out">
        <div class="out-left">
          <span class="pre">§ Politique</span>
          <h3>Une stack courte, défendable, à jour.</h3>
          <p>
            Je préfère <em>refuser une techno</em> plutôt que de la lister sans
            pouvoir la maîtriser sous pression. La BOM ci-dessus est le strict
            minimum que je maîtrise en autonomie.
          </p>
          <p>
            Le reste — ce que j'ai touché sans le revendiquer, et ce que je
            décline explicitement — est tout aussi important pour comprendre
            mon profil technique.
          </p>
        </div>

        <div class="out-right">
          <div class="out-card has-touched">
            <div class="pre"><span class="swatch"></span>Touché — non revendiqué</div>
            <ul>
              <li>Rust embedded<span class="lbl">curiosité 2024</span></li>
              <li>Go (microservices)<span class="lbl">2 projets 2022</span></li>
              <li>Kotlin / Android<span class="lbl">app interne</span></li>
              <li>Terraform<span class="lbl">avec un collègue</span></li>
              <li>Three.js / WebGL<span class="lbl">démos client</span></li>
              <li>Elixir / Phoenix<span class="lbl">POC seul</span></li>
            </ul>
          </div>
          <div class="out-card no">
            <div class="pre"><span class="swatch"></span>Décliné — par principe</div>
            <ul>
              <li>JS framework du mois<span class="lbl">trop volatile</span></li>
              <li>No-code en cœur<span class="lbl">non auditable</span></li>
              <li>NoSQL document-only<span class="lbl">si schéma stable</span></li>
              <li>Cloud lock-in profond<span class="lbl">on-prem-first</span></li>
              <li>Gen-AI en boucle critique<span class="lbl">si non-déterministe</span></li>
              <li>Stack JVM lourde<span class="lbl">hors contexte fort</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="cta" id="contact">
      <div>
        <h2>Cette BOM matche votre <span class="em">besoin</span> ?</h2>
        <p>
          Architecture système, FPGA, embarqué — si un sujet technique de
          cette page vous intéresse, écrivez-moi. Réponse sous 48 h ouvrées.
        </p>
      </div>
      <div class="cta-links">
        <a href="mailto:julien.aupart@gmail.com"><span class="k">email</span><span>julien.aupart@gmail.com →</span></a>
        <a href="/contact/"><span class="k">contact</span><span>formulaire de contact →</span></a>
        <a href="https://github.com/Julien1138" target="_blank" rel="noopener"><span class="k">github</span><span>@Julien1138 →</span></a>
        <a href="#"><span class="k">cv</span><span>cv-2026.pdf →</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero { border-bottom: 1.5px solid var(--ink); display: grid; grid-template-columns: 1.45fr 1fr; }
  .hero-left { padding: 56px 56px 56px 0; border-right: 1px solid var(--rule); }
  .hero-right { padding: 56px 0 56px 56px; }

  .field-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); display: block; margin-bottom: 10px; }
  .hero h1 { font-family: var(--sans); font-weight: 700; font-size: clamp(48px, 6vw, 80px); line-height: 0.96; letter-spacing: -0.035em; margin: 0; color: var(--ink); }
  .hero h1 .em { color: var(--accent); font-family: var(--serif); font-weight: 500; font-style: italic; }
  .hero h1 .dot { color: var(--accent); }
  .hero .role { margin-top: 14px; font-family: var(--serif); font-size: 22px; line-height: 1.3; color: var(--ink-2); font-weight: 400; font-style: italic; max-width: 540px; }
  .hero p.lead { margin: 22px 0 0; font-family: var(--serif); font-size: 17px; line-height: 1.65; color: var(--ink-2); max-width: 540px; text-wrap: pretty; }
  .hero p.lead :global(em.hl) {
    font-style: normal;
    background: linear-gradient(transparent 62%, var(--accent-soft) 62%, var(--accent-soft) 92%, transparent 92%);
    padding: 0 2px;
    color: var(--ink);
  }
  :global(html[data-theme="dark"]) .hero p.lead :global(em.hl) { color: var(--accent-2); }

  .meta { font-family: var(--mono); font-size: 12.5px; }
  .meta .row { display: grid; grid-template-columns: 140px 1fr; padding: 9px 0; border-bottom: 1px dotted var(--rule-2); align-items: baseline; }
  .meta .row:last-child { border-bottom: none; }
  .meta .k { color: var(--ink-soft); text-transform: uppercase; font-size: 10.5px; letter-spacing: 0.1em; }
  .meta .v { color: var(--ink); }
  .meta .v.accent { color: var(--accent); }
  .meta .v :global(.badge) {
    display: inline-block; padding: 1px 7px;
    background: var(--accent-soft); color: var(--accent-2);
    font-size: 11px; letter-spacing: 0.06em; margin-left: 6px; border-radius: 2px;
  }

  .kpis { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--rule); }
  .kpi { padding: 26px 28px; border-right: 1px solid var(--rule); display: flex; flex-direction: column; gap: 4px; }
  .kpi:last-child { border-right: none; }
  .kpi .k { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }
  .kpi .v { font-family: var(--sans); font-weight: 600; font-size: 36px; line-height: 1; letter-spacing: -0.025em; color: var(--ink); }
  .kpi .v .u { font-size: 18px; font-weight: 500; color: var(--ink-soft); margin-left: 4px; letter-spacing: 0; }
  .kpi .v.accent { color: var(--accent); }
  .kpi .sub { font-family: var(--serif); font-style: italic; font-size: 13.5px; color: var(--ink-3); margin-top: 6px; }

  section.block { padding: 64px 0; border-bottom: 1px solid var(--rule); }
  section.block:last-of-type { border-bottom: none; }

  .out { display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; align-items: start; }
  .out-left .pre { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .out-left h3 { font-family: var(--sans); font-weight: 600; font-size: 30px; line-height: 1.05; letter-spacing: -0.02em; margin: 8px 0 14px; }
  .out-left p { font-family: var(--serif); font-size: 16px; line-height: 1.6; color: var(--ink-2); max-width: 440px; margin: 0 0 14px; }
  .out-left p em { font-style: italic; color: var(--ink); }

  .out-right { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .out-card { border: 1px solid var(--rule); padding: 18px 20px; background: var(--paper); }
  .out-card .pre { font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
  .out-card .pre .swatch { width: 10px; height: 10px; border-radius: 50%; background: var(--ink-soft); flex-shrink: 0; }
  .out-card.has-touched .pre .swatch { background: var(--amber); }
  .out-card.no .pre .swatch { background: var(--accent); }
  .out-card ul { list-style: none; margin: 0; padding: 0; font-family: var(--mono); font-size: 12px; color: var(--ink-2); line-height: 1.85; }
  .out-card ul li { border-bottom: 1px dotted var(--rule-2); padding: 3px 0; }
  .out-card ul li:last-child { border-bottom: none; }
  .out-card ul li .lbl { color: var(--ink-soft); font-size: 10.5px; margin-left: 6px; text-transform: uppercase; letter-spacing: 0.08em; }

  .cta { padding: 80px 0 96px; display: grid; grid-template-columns: 1.3fr 1fr; gap: 60px; align-items: end; }
  .cta h2 { font-family: var(--sans); font-weight: 600; font-size: 52px; line-height: 1; letter-spacing: -0.025em; margin: 0; max-width: 540px; }
  .cta h2 .em { color: var(--accent); font-style: italic; font-family: var(--serif); font-weight: 500; }
  .cta p { font-family: var(--serif); font-size: 17px; color: var(--ink-2); line-height: 1.55; margin: 22px 0 0; max-width: 480px; }
  .cta-links { display: flex; flex-direction: column; gap: 0; font-family: var(--mono); font-size: 13px; }
  .cta-links a {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 0; border-bottom: 1px solid var(--rule); color: var(--ink);
    letter-spacing: 0.04em; transition: color 150ms ease, padding-left 150ms ease;
  }
  .cta-links a:first-child { border-top: 1px solid var(--rule); }
  .cta-links a .k { color: var(--ink-soft); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; }
  .cta-links a:hover { color: var(--accent); padding-left: 4px; }
  .cta-links a:hover .k { color: var(--accent); }

  @media (max-width: 1100px) {
    .hero { grid-template-columns: 1fr; }
    .hero-left { padding: 48px 0; border-right: none; border-bottom: 1px solid var(--rule); }
    .hero-right { padding: 48px 0; }
    .kpis { grid-template-columns: repeat(2, 1fr); }
    .kpi:nth-child(2) { border-right: none; }
    .kpi:nth-child(1), .kpi:nth-child(2) { border-bottom: 1px solid var(--rule); }
    .out { grid-template-columns: 1fr; }
    .cta { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 820px) {
    .hero h1 { font-size: 44px; }
    .out-right { grid-template-columns: 1fr; }
    .kpis { grid-template-columns: 1fr 1fr; }
    .cta h2 { font-size: 36px; }
  }
</style>
