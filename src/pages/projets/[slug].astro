---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProgressBar from "../../components/ProgressBar.astro";
import BreadcrumbNav from "../../components/BreadcrumbNav.astro";
import MetaStrip from "../../components/MetaStrip.astro";
import ChipRow from "../../components/ChipRow.astro";
import PlaceholderFigure from "../../components/PlaceholderFigure.astro";
import SectionRenderer from "../../components/blocks/SectionRenderer.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const ordered = projects.slice().sort((a, b) => a.data.order - b.data.order);
  return ordered.map((p, i) => ({
    params: { slug: p.id },
    props: {
      project: p,
      prev: ordered[i - 1] ?? null,
      next: ordered[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const dd = d.deepDive;
---

<BaseLayout
  title={`${d.ref} · ${d.title} — Jean Dupont`}
  active={2}
  container="doc"
  stripFields={[
    { label: "FICHE", value: "JD-ENG / PROJET" },
    { label: "RÉF", value: d.ref },
    { label: "DOC", value: "DEEP-DIVE" },
    { label: "PAGE", value: "01 / 01" },
  ]}
>
  <ProgressBar />
  <article class="container">
    <BreadcrumbNav crumbs={[{ label: "Projets", href: "/projets/" }, { label: `${d.ref} · ${d.title}` }]} />

    <header class="doc-header">
      <div class="meta-top">{dd ? dd.metaTop : `${d.ref} · ${d.category} · ${d.period}`}</div>
      <h1>{d.title}.</h1>
      <p class="lede" set:html={d.lede} />

      {dd && <MetaStrip cells={dd.metaStrip} />}
      <ChipRow chips={d.chips} class="header-chips" />
    </header>

    <div class="hero-fig-wrap">
      <PlaceholderFigure tag={dd ? dd.heroFigTag : d.figTag} minHeight="320px" />
      {dd && (
        <p class="fig-caption">
          <span class="ref">{dd.figCaptionRef}</span>
          <span>{dd.figCaptionText}</span>
        </p>
      )}
    </div>

    {dd && <SectionRenderer sections={dd.sections} />}

    <nav class="proj-nav" aria-label="Navigation projets">
      {prev ? (
        <a href={`/projets/${prev.id}/`}>
          <span class="dir">← Projet précédent</span>
          <span class="title">{prev.data.ref} · {prev.data.title}</span>
        </a>
      ) : <span></span>}
      {next ? (
        <a href={`/projets/${next.id}/`} class="right">
          <span class="dir">Projet suivant →</span>
          <span class="title">{next.data.ref} · {next.data.title}</span>
        </a>
      ) : <span></span>}
    </nav>
  </article>
</BaseLayout>

<style>
  .doc-header { padding: 28px 0 0; }
  .doc-header .meta-top {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .doc-header h1 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(44px, 5.6vw, 72px);
    line-height: 1.0;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
    max-width: 820px;
  }
  .doc-header .lede {
    font-family: var(--serif);
    font-size: 22px;
    line-height: 1.45;
    color: var(--ink-2);
    font-weight: 400;
    margin: 0;
    max-width: 720px;
  }
  .doc-header .lede :global(em) { color: var(--ink); font-style: italic; font-weight: 500; }
  .header-chips { margin-top: 24px; }

  .hero-fig-wrap { margin: 40px 0 8px; }
  .fig-caption {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
    margin: 8px 0 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .fig-caption .ref { color: var(--accent); letter-spacing: 0.1em; text-transform: uppercase; }

  .proj-nav {
    margin: 80px 0 64px;
    padding-top: 28px;
    border-top: 1.5px solid var(--ink);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .proj-nav a {
    display: flex;
    flex-direction: column;
    padding: 18px 22px;
    border: 1px solid var(--rule);
    transition: background 150ms ease, border-color 150ms ease;
  }
  .proj-nav a:hover { background: var(--paper-2); border-color: var(--accent); }
  .proj-nav a .dir {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .proj-nav a:hover .dir { color: var(--accent); }
  .proj-nav a .title { font-family: var(--sans); font-weight: 600; font-size: 17px; }
  .proj-nav a.right { text-align: right; }

  @media (max-width: 760px) {
    .doc-header h1 { font-size: 40px; }
    .doc-header .lede { font-size: 18px; }
  }
  @media (max-width: 1100px) {
    .proj-nav { grid-template-columns: 1fr; }
    .proj-nav a.right { text-align: left; }
  }
</style>
