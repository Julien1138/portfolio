---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProgressBar from "../../components/ProgressBar.astro";
import MetaStrip from "../../components/MetaStrip.astro";
import CapabilityMap from "../../components/CapabilityMap.astro";
import TimelineEntries from "../../components/TimelineEntries.astro";
import RelatedGrid from "../../components/RelatedGrid.astro";
import H2Row from "../../components/H2Row.astro";

// timeline.json is authored most-recent-first already
const entries = (await getCollection("timeline")).map((e) => e.data);

const lanes = [
  {
    label: "Embedded", color: "var(--accent)",
    segments: [
      { from: 2009, to: 2014, label: "STM32 · firmware", style: "intense" as const },
      { from: 2014, to: 2018, label: "ARM · RTOS", style: "intense" as const },
      { from: 2018, to: 2021, label: "medtech · IEC", style: "intense" as const },
      { from: 2021, to: 2024, label: "ponctuel", style: "outline" as const },
      { from: 2024, to: 2026, label: "ESP-IDF · IoT", style: "intense" as const },
    ],
  },
  {
    label: "FPGA", color: "var(--accent-2)",
    segments: [
      { from: 2014, to: 2017, label: "init.", style: "outline" as const },
      { from: 2017, to: 2021, label: "JCDecaux · LED · vision", style: "intense" as const },
      { from: 2024, to: 2026, label: "conseil", style: "outline" as const },
    ],
  },
  {
    label: "Backend", color: "var(--blue)",
    segments: [
      { from: 2014, to: 2016, label: "PHP · MySQL", style: "outline" as const },
      { from: 2016, to: 2021, label: "Symfony · API Platform", style: "intense" as const },
      { from: 2021, to: 2026, label: "SF + Node · Postgres + Timescale", style: "intense" as const },
    ],
  },
  {
    label: "Frontend", color: "var(--violet)",
    segments: [
      { from: 2015, to: 2017, label: "jQuery · SCSS", style: "outline" as const },
      { from: 2017, to: 2020, label: "Vue 2", style: "outline" as const },
      { from: 2020, to: 2026, label: "Vue 3 · React · TS", style: "intense" as const },
    ],
  },
  {
    label: "Infra · DevOps", color: "var(--green)",
    segments: [
      { from: 2014, to: 2018, label: "Linux · scripts", style: "outline" as const },
      { from: 2018, to: 2022, label: "Docker · CI/CD", style: "intense" as const },
      { from: 2022, to: 2026, label: "K8s · observability", style: "intense" as const },
    ],
  },
  {
    label: "Leadership", color: "var(--ink)", lead: true,
    segments: [
      { from: 2016, to: 2018, label: "mentor", style: "outline" as const },
      { from: 2018, to: 2021, label: "tech lead — équipe 5", style: "intense" as const },
      { from: 2021, to: 2024, label: "lead architect — 10 devs", style: "intense" as const },
      { from: 2024, to: 2026, label: "CTO intérim · conseil", style: "intense" as const },
    ],
  },
];
---

<BaseLayout
  title="À propos · Parcours · Julien Aupart — Ingénieur système"
  active={4}
  container="doc"
  stripFields={[
    { label: "FICHE", value: "A-01 / À PROPOS" },
    { label: "DEPUIS", value: "2009" },
    { label: "DISPO", value: "Q3 2026" },
    { label: "PAGE", value: "04 / 06" },
  ]}
>
  <ProgressBar />
  <div class="container">
    <nav class="breadcrumb" aria-label="Fil d'ariane">
      <a href="/">portfolio</a>
      <span class="sep">/</span>
      <span class="here">à propos · parcours</span>
    </nav>

    <header class="doc-header">
      <div class="meta-top">A-01 · About · Parcours · 17 ans d'ingénierie</div>
      <h1>Du transistor <span class="amp">au</span> cluster Kubernetes.</h1>
      <p class="lede">
        Ingénieur système depuis 2009. J'ai porté des produits complexes
        de la spec initiale à la production : <em>firmware embarqué,
        électronique numérique, FPGA, backend, frontend, infra</em>.
        Une seule pile cohérente, une seule personne aux frontières.
      </p>

      <MetaStrip
        cells={[
          { k: "Localisation", v: "Lyon · remote EU" },
          { k: "Expérience", v: "17 ans · depuis 2009", accent: true },
          { k: "Rôles tenus", v: "6 · jr → architecte" },
          { k: "Domaines", v: "Embarqué · Web · Infra" },
          { k: "Lecture", v: "~ 6 min" },
        ]}
      />

      <div class="chip-row">
        <span class="chip accent">Architecte système</span>
        <span class="chip accent">Lead technique</span>
        <span class="chip accent">CTO intérim</span>
        <span class="chip">Embedded · C/C++</span>
        <span class="chip">FPGA · VHDL</span>
        <span class="chip">Backend · PHP/Node</span>
        <span class="chip">Frontend · Vue/React</span>
        <span class="chip">Infra · K8s/Docker</span>
        <span class="chip">Spec-driven</span>
        <span class="chip">IEC 62304</span>
      </div>
    </header>

    <section class="portrait-row">
      <div class="intro">
        <p>
          Mon métier : prendre un système complexe — pile complète, du
          silicium au cloud — et le rendre <span class="hl">simple,
          traçable, défendable en audit</span>.
        </p>
        <p>
          Concrètement, ça veut dire que je sais lire un schéma, dompter
          un FPGA récalcitrant, refactorer une base Symfony de 2014,
          écrire un dashboard Vue 3, et déployer le tout en K8s — sans
          que les coutures soient visibles. Cette continuité est rare,
          et c'est exactement là que je crée de la valeur : <b>aux
          frontières du système</b>, là où les pannes se cachent et où
          les arbitrages coûtent cher.
        </p>
        <p>
          Ce qui m'intéresse : la qualité, l'architecture, la
          traçabilité — et les systèmes où l'on doit <em>prouver</em>
          que ça marche, pas juste sentir que ça marche.
        </p>
      </div>
      <figure class="portrait" aria-label="Portrait — placeholder">
        <div class="ph-stripes"></div>
        <span class="ph-mark">JD · 01</span>
        <div class="ph-center">[ PORTRAIT ]</div>
        <span class="ph-tag">photo · 4:5 · à fournir</span>
      </figure>
    </section>

    <CapabilityMap yMin={2009} yMax={2026} lanes={lanes} />

    <section class="section" id="parcours">
      <H2Row title="Parcours." num="§ 01 — Timeline" sub={`2009 → 2026 · ${entries.length} postes`} />
      <TimelineEntries entries={entries} />
    </section>

    <section class="section" id="chiffres">
      <H2Row title="Chiffres-clés." num="§ 02 — Indicateurs" sub="à fin Q2 2026" />
      <div class="stats">
        <div class="cell">
          <div class="n">17<span class="unit">&nbsp;ans</span></div>
          <div class="t">d'ingénierie continue</div>
          <div class="d">Depuis septembre 2009. Aucune coupure de plus de 6 semaines.</div>
        </div>
        <div class="cell">
          <div class="n">6</div>
          <div class="t">postes · 4 employeurs</div>
          <div class="d">Junior → architecte. Aucun changement vertical sans raison technique.</div>
        </div>
        <div class="cell">
          <div class="n">23</div>
          <div class="t">projets pilotés en lead</div>
          <div class="d">Du firmware standalone au SaaS multi-tenant. 19 toujours en production.</div>
        </div>
        <div class="cell">
          <div class="n">5k+</div>
          <div class="t">nœuds embarqués en terrain</div>
          <div class="d">Compteurs énergie, capteurs industriels, dispositifs médicaux.</div>
        </div>
      </div>
    </section>

    <section class="section" id="methode">
      <H2Row title="Méthode." num="§ 03 — Principes" sub="comment je travaille" />
      <div class="method">
        <div class="card">
          <span class="id">M-01 · Process</span>
          <h4>Spec → code → test → audit.</h4>
          <p>
            Chaque exigence portée par un ID. Spec versionnée. Traçabilité
            descendante : exigence → conception → code → test. Audit-ready
            par défaut, pas en panique avant un rendez-vous notifié.
          </p>
          <div class="signal">→ <b>Outil de référence</b> : DOORS / GitLab issues + matrice de traçabilité.</div>
        </div>
        <div class="card">
          <span class="id">M-02 · Archi</span>
          <h4>Boring tech, justifié.</h4>
          <p>
            Le moins de pièces mobiles possible. Postgres avant Cassandra,
            monolithe modulaire avant microservices, Docker Compose avant
            Kubernetes. <b>Optimiser quand on mesure</b>, jamais en
            anticipation.
          </p>
          <div class="signal">→ <b>Marqueur</b> : si je propose une techno récente, c'est qu'elle a déjà été tenue 2 ans en prod ailleurs.</div>
        </div>
        <div class="card">
          <span class="id">M-03 · Système</span>
          <h4>Du HW au cloud, vue continue.</h4>
          <p>
            Une vue cohérente du système complet — du transistor au
            dashboard. Les arbitrages les plus coûteux sont aux frontières
            entre couches : <b>je les connais toutes</b>, donc je les vois
            venir.
          </p>
          <div class="signal">→ <b>Différenciateur</b> : pas de hand-off bruyant entre équipes hardware et software.</div>
        </div>
      </div>

      <div class="pull">
        <p class="body">
          « Faire simple coûte du temps en conception, et rapporte du
          temps tous les jours après le déploiement. Le mauvais
          arbitrage, c'est de l'oublier sous pression. »
        </p>
        <div class="sig">— note d'atelier · 2023</div>
      </div>
    </section>

    <section class="section" id="hors-ecran">
      <H2Row title="Hors-écran." num="§ 04 — Off-duty" sub="ce qui nourrit le reste" />
      <div class="hors">
        <div class="text">
          <p>
            Le métier d'ingénieur système se nourrit autant de ce qu'on
            fait à l'écran que de ce qu'on lit, écrit, démonte ou
            transmet en dehors. Quelques pratiques que j'entretiens :
          </p>
          <p>
            Je lis régulièrement les <b>retours d'incident</b> publiés
            par les équipes infra (AWS, GitLab, Cloudflare) — c'est la
            meilleure école d'architecture défensive qui existe. Je
            tiens un side-project VHDL pour ne pas perdre la main bas
            niveau, et j'écris occasionnellement sur le spec-driven
            embedded.
          </p>
          <p>
            Quand l'écran fatigue : vélo route en montagne, et
            photographie argentique noir &amp; blanc.
          </p>
        </div>
        <div class="list">
          <div class="k">Activités · 2026</div>
          <ul>
            <li><span class="n">01</span><span><b>Lectures techniques</b> · postmortems, papers archi data</span></li>
            <li><span class="n">02</span><span><b>Side-project VHDL</b> · décodeur protocole vintage</span></li>
            <li><span class="n">03</span><span><b>Mentorat ponctuel</b> · 2 juniors externes / mois</span></li>
            <li><span class="n">04</span><span><b>Articles</b> · spec-driven embedded · ~4 / an</span></li>
            <li><span class="n">05</span><span><b>Vélo route</b> · Alpes — 4 000 km / an</span></li>
            <li><span class="n">06</span><span><b>Photographie</b> · argentique N&amp;B, 35 mm</span></li>
          </ul>
        </div>
      </div>
    </section>

    <RelatedGrid
      label="Aller plus loin · sections liées"
      items={[
        { ref: "→ Rôles · R-02", title: "Expert FPGA · JCDecaux", sub: "Le cœur de l'expertise bas-niveau, détaillée.", href: "/roles/r-02-jcdecaux-fpga/" },
        { ref: "→ Page 05", title: "Stack technique", sub: "BOM complète, par couche, avec niveau de maîtrise.", href: "/stack/" },
        { ref: "→ Page 06", title: "Contact", sub: "Discuter d'une mission. Réponse sous 48 h.", href: "/contact/" },
      ]}
    />
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    padding-top: 36px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
  }
  .breadcrumb .here { color: var(--ink); }
  .breadcrumb .sep { color: var(--ink-soft); margin: 0 6px; }
  .breadcrumb a:hover { color: var(--ink); }

  .doc-header { padding: 28px 0 0; }
  .doc-header .meta-top {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .doc-header h1 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(44px, 5.6vw, 72px);
    line-height: 1.0;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
    max-width: 820px;
  }
  .doc-header h1 .amp { color: var(--accent); font-style: italic; font-family: var(--serif); font-weight: 500; }
  .doc-header .lede {
    font-family: var(--serif);
    font-size: 22px;
    line-height: 1.45;
    color: var(--ink-2);
    font-weight: 400;
    margin: 0;
    max-width: 720px;
  }
  .doc-header .lede em { color: var(--ink); font-style: italic; font-weight: 500; }

  .chip-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 24px; }
  .chip {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 3px 9px;
    border: 1px solid var(--rule-2);
    background: var(--paper);
    color: var(--ink-2);
    border-radius: 2px;
  }
  .chip.accent { background: var(--accent-soft); color: var(--accent-2); border-color: var(--accent); }

  .portrait-row {
    margin-top: 40px;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 36px;
    align-items: start;
  }
  .portrait-row .intro p {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0 0 14px;
    max-width: 520px;
    text-wrap: pretty;
  }
  .portrait-row .intro p:first-child { font-size: 20px; color: var(--ink); font-weight: 500; }
  .portrait-row .intro p b { color: var(--ink); font-weight: 600; }
  .portrait-row .intro :global(.hl) {
    background: linear-gradient(transparent 62%, var(--accent-soft) 62%, var(--accent-soft) 92%, transparent 92%);
    padding: 0 2px;
    color: var(--ink);
  }
  :global(html[data-theme="dark"]) .portrait-row .intro :global(.hl) { color: var(--accent-2); }

  .portrait {
    margin: 0;
    border: 1px solid var(--rule);
    background: var(--paper-2);
    aspect-ratio: 4 / 5;
    position: relative;
    overflow: hidden;
  }
  .portrait .ph-stripes {
    position: absolute; inset: 0;
    background-image: repeating-linear-gradient(135deg, transparent 0 18px, var(--rule) 18px 19px);
    opacity: 0.4;
  }
  .portrait .ph-tag {
    position: absolute;
    bottom: 12px; left: 12px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: var(--paper);
    border: 1px solid var(--rule-2);
    padding: 4px 8px;
  }
  .portrait .ph-mark {
    position: absolute;
    top: 12px; right: 12px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
  }
  .portrait .ph-center {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--ink-3);
  }

  .section { margin-top: 64px; }

  .stats {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--rule);
  }
  .stats .cell { padding: 22px 22px 20px; border-right: 1px solid var(--rule); background: var(--paper); }
  .stats .cell:nth-child(2n) { background: var(--paper-2); }
  .stats .cell:last-child { border-right: none; }
  .stats .cell .n {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 46px;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--accent);
  }
  .stats .cell .n .unit {
    font-family: var(--mono);
    font-size: 16px;
    color: var(--ink-soft);
    font-weight: 500;
    letter-spacing: 0.02em;
    margin-left: 2px;
  }
  .stats .cell .t { font-family: var(--sans); font-weight: 600; font-size: 14px; color: var(--ink); margin-top: 10px; letter-spacing: -0.005em; }
  .stats .cell .d { font-family: var(--serif); font-size: 13.5px; color: var(--ink-3); margin-top: 4px; line-height: 1.4; }

  .method { margin-top: 24px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .method .card { padding: 22px 20px 22px; background: var(--paper-2); border: 1px solid var(--rule); display: flex; flex-direction: column; gap: 8px; }
  .method .card .id { font-family: var(--mono); font-size: 10px; letter-spacing: 0.16em; color: var(--accent); text-transform: uppercase; }
  .method .card h4 { font-family: var(--sans); font-weight: 600; font-size: 17px; letter-spacing: -0.01em; margin: 0; color: var(--ink); }
  .method .card p { font-family: var(--serif); font-size: 14.5px; line-height: 1.5; color: var(--ink-2); margin: 4px 0 0; }
  .method .card .signal {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px dotted var(--rule-2);
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
  }
  .method .card .signal b { color: var(--ink); font-weight: 600; }

  .pull {
    margin: 32px 0 0;
    padding: 24px 28px 26px;
    background: var(--paper-2);
    border-left: 3px solid var(--accent);
    max-width: 760px;
  }
  .pull .body { font-family: var(--serif); font-style: italic; font-size: 21px; line-height: 1.4; color: var(--ink); margin: 0; text-wrap: pretty; }
  .pull .sig { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); margin-top: 12px; }

  .hors { margin-top: 24px; display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px; }
  .hors .text p { font-family: var(--serif); font-size: 16px; line-height: 1.6; color: var(--ink-2); margin: 0 0 12px; max-width: var(--prose); }
  .hors .text p b { color: var(--ink); font-weight: 600; }
  .hors .list { background: var(--paper-2); border: 1px solid var(--rule); padding: 18px 20px; }
  .hors .list .k { font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 8px; }
  .hors .list ul { margin: 0; padding: 0; list-style: none; }
  .hors .list li {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 8px;
    padding: 8px 0;
    border-top: 1px dotted var(--rule-2);
    font-family: var(--serif);
    font-size: 14.5px;
    color: var(--ink-2);
  }
  .hors .list li:first-child { border-top: none; }
  .hors .list li .n { font-family: var(--mono); font-size: 10px; color: var(--accent); letter-spacing: 0.06em; padding-top: 3px; }
  .hors .list li b { color: var(--ink); font-weight: 600; }

  @media (max-width: 1100px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats .cell:nth-child(2) { border-right: none; }
    .method { grid-template-columns: 1fr; }
    .hors { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .doc-header h1 { font-size: 40px; }
    .portrait-row { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr; }
    .stats .cell { border-right: none; border-bottom: 1px solid var(--rule); }
  }
</style>
