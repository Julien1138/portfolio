---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import portraitImg from "../../assets/images/parcours/portrait-cropped.jpg";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProgressBar from "../../components/ProgressBar.astro";
import MetaStrip from "../../components/MetaStrip.astro";
import CapabilityMap from "../../components/CapabilityMap.astro";
import TimelineEntries from "../../components/TimelineEntries.astro";
import RelatedGrid from "../../components/RelatedGrid.astro";
import H2Row from "../../components/H2Row.astro";

const entries = (await getCollection("timeline"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => e.data);

const lanes = [
  {
    label: "FPGA · électronique num.", color: "var(--accent)",
    segments: [
      { from: 2008, to: 2009, label: "stages", style: "outline" as const },
      { from: 2009, to: 2012, label: "Safran", style: "intense" as const },
      { from: 2012, to: 2014, label: "Viveris", style: "intense" as const },
      { from: 2014, to: 2019, label: "JCDecaux · LED urbain", style: "intense" as const },
      { from: 2025, to: 2026, label: "Thales", style: "intense" as const },
    ],
  },
  {
    label: "Embedded C/C++", color: "var(--accent-2)",
    segments: [
      { from: 2008, to: 2009, label: "stages", style: "outline" as const },
      { from: 2009, to: 2012, label: "Safran", style: "intense" as const },
      { from: 2014, to: 2019, label: "JCDecaux · mobilier urbain", style: "intense" as const },
      { from: 2020, to: 2025, label: "ID-1 · ESP32-S3", style: "intense" as const },
    ],
  },
  {
    label: "Carte électronique", color: "var(--amber)",
    segments: [
      { from: 2012, to: 2014, label: "Viveris", style: "outline" as const },
      { from: 2014, to: 2019, label: "JCDecaux · mobilier urbain", style: "outline" as const },
      { from: 2020, to: 2025, label: "ID-1 · ESP32-S3", style: "intense" as const },
    ],
  },
  {
    label: "Backend web", color: "var(--blue)",
    segments: [
      { from: 2019, to: 2020, label: "Naept", style: "intense" as const },
      { from: 2020, to: 2025, label: "ID-1 · Symfony/API Platform", style: "intense" as const },
    ],
  },
  {
    label: "Frontend web", color: "var(--violet)",
    segments: [
      { from: 2019, to: 2020, label: "Naept", style: "intense" as const },
      { from: 2020, to: 2025, label: "ID-1 · Vue.js/Ionic", style: "intense" as const },
    ],
  },
  {
    label: "Infra · DevOps", color: "var(--green)",
    segments: [
      { from: 2019, to: 2020, label: "Naept", style: "outline" as const },
      { from: 2020, to: 2025, label: "ID-1 · Docker/CI-CD", style: "outline" as const },
    ],
  },
  {
    label: "Direction technique", color: "var(--slate)",
    segments: [
      { from: 2019, to: 2020, label: "Naept", style: "intense" as const },
      { from: 2020, to: 2025, label: "responsable dev — ID-1", style: "intense" as const },
    ],
  },
];
---

<BaseLayout
  title="À propos · Parcours · Julien Aupart — Ingénieur système"
  active={4}
  container="doc"
  stripFields={[
    { label: "FICHE", value: "A-01 / À PROPOS" },
    { label: "DEPUIS", value: "2009" },
    { label: "DISPO", value: "Q3 2026" },
    { label: "PAGE", value: "04 / 06" },
  ]}
>
  <ProgressBar />
  <div class="container">
    <nav class="breadcrumb" aria-label="Fil d'ariane">
      <a href="/">portfolio</a>
      <span class="sep">/</span>
      <span class="here">à propos · parcours</span>
    </nav>

    <header class="doc-header">
      <div class="meta-top">A-01 · About · Parcours · 17 ans d'ingénierie</div>
      <h1>Du silicium <span class="amp">à</span> l'écran.</h1>
      <p class="lede">
        Ingénieur système depuis 2009. J'ai porté des produits complexes
        de la spec initiale à la production : <em>électronique numérique,
        FPGA, embarqué, backend, frontend</em>. Une seule pile cohérente,
        une seule personne aux frontières.
      </p>

      <MetaStrip
        cells={[
          { k: "Localisation", v: "Septeuil (78) · remote EU" },
          { k: "Expérience", v: "17 ans · depuis 2009", accent: true },
          { k: "Postes tenus", v: "6 · ingénieur → expert" },
          { k: "Domaines", v: "FPGA · Embarqué · Web" },
          { k: "Lecture", v: "~ 6 min" },
        ]}
      />

      <div class="chip-row">
        <span class="chip accent">Embedded · C/C++</span>
        <span class="chip accent">Backend · Laravel/Symfony</span>
        <span class="chip accent">Frontend · Vue.js/React</span>
        <span class="chip">FPGA · VHDL</span>
        <span class="chip">Électronique numérique</span>
        <span class="chip">Docker · CI/CD</span>
        <span class="chip">Traçabilité des exigences</span>
        <span class="chip">DO-178B / DO-254</span>
      </div>
    </header>

    <section class="portrait-row">
      <div class="intro">
        <p>
          Mon métier : concevoir l'électronique et le firmware des
          systèmes qui ne doivent jamais tomber en panne — de
          l'avionique militaire aux écrans LED urbains, en passant par
          le SaaS et l'IoT industriel.
        </p>
        <p>
          Concrètement, ça veut dire lire un schéma, coder un FPGA en
          VHDL, écrire le firmware C/C++ qui pilote un capteur,
          refactorer une API Laravel ou Symfony, développer une
          interface Vue.js — et savoir où ces couches se rejoignent.
          Cette continuité entre le matériel et le logiciel s'est
          construite au fil de missions chez <b>Safran, Viveris,
          JCDecaux</b>, ma propre société <b>Naept</b>, <b>ID-1</b>, et
          aujourd'hui <b>Thales</b>.
        </p>
        <p>
          Ce qui m'intéresse : la rigueur du bas niveau. Les processus
          <span class="hl">DO-178B et DO-254</span> m'ont appris à
          documenter, tracer et prouver — pas juste à faire fonctionner.
        </p>
      </div>
      <figure class="portrait" aria-label="Portrait de Julien Aupart">
        <Image src={portraitImg} alt="Julien Aupart" width={576} height={720} />
      </figure>
    </section>

    <CapabilityMap yMin={2008} yMax={2026} lanes={lanes} />

    <section class="section" id="parcours">
      <H2Row title="Parcours." num="§ 01 — Timeline" sub={`2008 → 2026 · ${entries.length} étapes`} />
      <TimelineEntries entries={entries} />
    </section>

    <section class="section" id="chiffres">
      <H2Row title="Chiffres-clés." num="§ 02 — Indicateurs" sub="à fin 2026" />
      <div class="stats">
        <div class="cell">
          <div class="n">17<span class="unit">&nbsp;ans</span></div>
          <div class="t">d'ingénierie continue</div>
          <div class="d">Depuis septembre 2009, sans interruption.</div>
        </div>
        <div class="cell">
          <div class="n">6</div>
          <div class="t">postes · 6 employeurs</div>
          <div class="d">Ingénieur électronique → expert → direction technique → FPGA senior.</div>
        </div>
        <div class="cell">
          <div class="n">2</div>
          <div class="t">normes qualité avionique maîtrisées</div>
          <div class="d">DO-178B (logiciel) et DO-254 (hardware), chez Safran et Thales.</div>
        </div>
        <div class="cell">
          <div class="n">1</div>
          <div class="t">société co-fondée</div>
          <div class="d">Naept, 2019 — logiciel de traçabilité des exigences.</div>
        </div>
      </div>
    </section>

    <section class="section" id="methode">
      <H2Row title="Méthode." num="§ 03 — Principes" sub="comment je travaille" />
      <div class="method">
        <div class="card">
          <span class="id">M-01 · Process</span>
          <h4>Spec → code → test → audit.</h4>
          <p>
            Chaque exigence portée par un ID. Spec versionnée. Traçabilité
            descendante : exigence → conception → code → test. Audit-ready
            par défaut, pas en panique avant un rendez-vous notifié.
          </p>
          <div class="signal">→ <b>Outils de référence</b> : matrices de traçabilité Excel/Visio, suivi Jira.</div>
        </div>
        <div class="card">
          <span class="id">M-02 · Archi</span>
          <h4>Boring tech, justifié.</h4>
          <p>
            Le moins de pièces mobiles possible. Framework éprouvé (Laravel,
            Symfony) avant micro-services, Docker Compose avant
            sur-ingénierie. <b>Optimiser quand on mesure</b>, jamais en
            anticipation.
          </p>
          <div class="signal">→ <b>Marqueur</b> : si je propose une techno récente, c'est qu'elle a déjà été tenue 2 ans en prod ailleurs.</div>
        </div>
        <div class="card">
          <span class="id">M-03 · Système</span>
          <h4>Du HW au cloud, vue continue.</h4>
          <p>
            Une vue cohérente du système complet — du transistor au
            dashboard. Les arbitrages les plus coûteux sont aux frontières
            entre couches : <b>je les connais toutes</b>, donc je les vois
            venir.
          </p>
          <div class="signal">→ <b>Différenciateur</b> : pas de hand-off bruyant entre équipes hardware et software.</div>
        </div>
      </div>

      <div class="pull">
        <p class="body">
          « Faire simple coûte du temps en conception, et rapporte du
          temps tous les jours après le déploiement. Le mauvais
          arbitrage, c'est de l'oublier sous pression. »
        </p>
        <div class="sig">— note personnelle</div>
      </div>
    </section>

    <section class="section" id="hors-ecran">
      <H2Row title="Hors-écran." num="§ 04 — Off-duty" sub="ce qui nourrit le reste" />
      <div class="hors">
        <div class="text">
          <p>
            Le métier d'ingénieur système se nourrit autant de ce qu'on
            fait à l'écran que de ce qu'on fait en dehors. Quelques
            pratiques que j'entretiens :
          </p>
          <p>
            Je descends régulièrement sous terre pour la <b>spéléologie</b>,
            je pratique le <b>théâtre d'improvisation</b>, et je jardine —
            trois façons différentes de sortir la tête du code.
          </p>
          <p>
            Côté plus classique : course à pied, photographie, brassage
            de bière maison, et pilotage d'avion de tourisme.
          </p>
        </div>
        <div class="list">
          <div class="k">Activités</div>
          <ul>
            <li><span class="n">01</span><span><b>Spéléologie</b></span></li>
            <li><span class="n">02</span><span><b>Photographie</b></span></li>
            <li><span class="n">03</span><span><b>Théâtre d'improvisation</b></span></li>
            <li><span class="n">04</span><span><b>Jardinage</b></span></li>
            <li><span class="n">05</span><span><b>Course à pied</b></span></li>
            <li><span class="n">06</span><span><b>Brassage de bière</b></span></li>
            <li><span class="n">07</span><span><b>Pilotage d'avion de tourisme</b></span></li>
          </ul>
        </div>
      </div>
    </section>

    <RelatedGrid
      label="Aller plus loin · sections liées"
      items={[
        { ref: "→ Rôles · R-02", title: "Expert FPGA · JCDecaux", sub: "Le cœur de l'expertise bas-niveau, détaillée.", href: "/roles/r-02-jcdecaux-fpga/" },
        { ref: "→ Page 05", title: "Stack technique", sub: "BOM complète, par couche, avec niveau de maîtrise.", href: "/stack/" },
        { ref: "→ Page 06", title: "Contact", sub: "Discuter d'une mission. Réponse sous 48 h.", href: "/contact/" },
      ]}
    />
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    padding-top: 36px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
  }
  .breadcrumb .here { color: var(--ink); }
  .breadcrumb .sep { color: var(--ink-soft); margin: 0 6px; }
  .breadcrumb a:hover { color: var(--ink); }

  .doc-header { padding: 28px 0 0; }
  .doc-header .meta-top {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .doc-header h1 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(44px, 5.6vw, 72px);
    line-height: 1.0;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
    max-width: 820px;
  }
  .doc-header h1 .amp { color: var(--accent); font-style: italic; font-family: var(--serif); font-weight: 500; }
  .doc-header .lede {
    font-family: var(--serif);
    font-size: 22px;
    line-height: 1.45;
    color: var(--ink-2);
    font-weight: 400;
    margin: 0;
    max-width: 720px;
  }
  .doc-header .lede em { color: var(--ink); font-style: italic; font-weight: 500; }

  .chip-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 24px; }
  .chip {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 3px 9px;
    border: 1px solid var(--rule-2);
    background: var(--paper);
    color: var(--ink-2);
    border-radius: 2px;
  }
  .chip.accent { background: var(--accent-soft); color: var(--accent-2); border-color: var(--accent); }

  .portrait-row {
    margin-top: 40px;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 36px;
    align-items: start;
  }
  .portrait-row .intro p {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0 0 14px;
    max-width: 520px;
    text-wrap: pretty;
  }
  .portrait-row .intro p:first-child { font-size: 20px; color: var(--ink); font-weight: 500; }
  .portrait-row .intro p b { color: var(--ink); font-weight: 600; }
  .portrait-row .intro :global(.hl) {
    background: linear-gradient(transparent 62%, var(--accent-soft) 62%, var(--accent-soft) 92%, transparent 92%);
    padding: 0 2px;
    color: var(--ink);
  }
  :global(html[data-theme="dark"]) .portrait-row .intro :global(.hl) { color: var(--accent-2); }

  .portrait {
    margin: 0;
    border: 1px solid var(--rule);
    background: var(--paper-2);
    aspect-ratio: 4 / 5;
    position: relative;
    overflow: hidden;
  }
  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .section { margin-top: 64px; }

  .stats {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--rule);
  }
  .stats .cell { padding: 22px 22px 20px; border-right: 1px solid var(--rule); background: var(--paper); }
  .stats .cell:nth-child(2n) { background: var(--paper-2); }
  .stats .cell:last-child { border-right: none; }
  .stats .cell .n {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 46px;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--accent);
  }
  .stats .cell .n .unit {
    font-family: var(--mono);
    font-size: 16px;
    color: var(--ink-soft);
    font-weight: 500;
    letter-spacing: 0.02em;
    margin-left: 2px;
  }
  .stats .cell .t { font-family: var(--sans); font-weight: 600; font-size: 14px; color: var(--ink); margin-top: 10px; letter-spacing: -0.005em; }
  .stats .cell .d { font-family: var(--serif); font-size: 13.5px; color: var(--ink-3); margin-top: 4px; line-height: 1.4; }

  .method { margin-top: 24px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .method .card { padding: 22px 20px 22px; background: var(--paper-2); border: 1px solid var(--rule); display: flex; flex-direction: column; gap: 8px; }
  .method .card .id { font-family: var(--mono); font-size: 10px; letter-spacing: 0.16em; color: var(--accent); text-transform: uppercase; }
  .method .card h4 { font-family: var(--sans); font-weight: 600; font-size: 17px; letter-spacing: -0.01em; margin: 0; color: var(--ink); }
  .method .card p { font-family: var(--serif); font-size: 14.5px; line-height: 1.5; color: var(--ink-2); margin: 4px 0 0; }
  .method .card .signal {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px dotted var(--rule-2);
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
  }
  .method .card .signal b { color: var(--ink); font-weight: 600; }

  .pull {
    margin: 32px 0 0;
    padding: 24px 28px 26px;
    background: var(--paper-2);
    border-left: 3px solid var(--accent);
    max-width: 760px;
  }
  .pull .body { font-family: var(--serif); font-style: italic; font-size: 21px; line-height: 1.4; color: var(--ink); margin: 0; text-wrap: pretty; }
  .pull .sig { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); margin-top: 12px; }

  .hors { margin-top: 24px; display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px; }
  .hors .text p { font-family: var(--serif); font-size: 16px; line-height: 1.6; color: var(--ink-2); margin: 0 0 12px; max-width: var(--prose); }
  .hors .text p b { color: var(--ink); font-weight: 600; }
  .hors .list { background: var(--paper-2); border: 1px solid var(--rule); padding: 18px 20px; }
  .hors .list .k { font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 8px; }
  .hors .list ul { margin: 0; padding: 0; list-style: none; }
  .hors .list li {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 8px;
    padding: 8px 0;
    border-top: 1px dotted var(--rule-2);
    font-family: var(--serif);
    font-size: 14.5px;
    color: var(--ink-2);
  }
  .hors .list li:first-child { border-top: none; }
  .hors .list li .n { font-family: var(--mono); font-size: 10px; color: var(--accent); letter-spacing: 0.06em; padding-top: 3px; }
  .hors .list li b { color: var(--ink); font-weight: 600; }

  @media (max-width: 1100px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats .cell:nth-child(2) { border-right: none; }
    .method { grid-template-columns: 1fr; }
    .hors { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .doc-header h1 { font-size: 40px; }
    .portrait-row { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr; }
    .stats .cell { border-right: none; border-bottom: 1px solid var(--rule); }
  }
</style>
