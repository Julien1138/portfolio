<button id="theme-toggle" class="theme-toggle" aria-label="Basculer le thème clair/sombre" title="Thème clair / sombre">
  <span class="glyph sun" aria-hidden="true">☀</span>
  <span class="glyph moon" aria-hidden="true">☾</span>
</button>

<style>
  .theme-toggle {
    position: fixed;
    right: 20px;
    bottom: 20px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--rule-2);
    border-radius: 4px;
    box-shadow: 0 8px 32px -8px rgba(0, 0, 0, 0.18), 0 2px 6px -2px rgba(0, 0, 0, 0.08);
    cursor: pointer;
    z-index: 100;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
  .theme-toggle .glyph {
    font-size: 15px;
    line-height: 1;
    display: none;
  }
  :global(html:not([data-theme="dark"])) .theme-toggle .sun { display: block; }
  :global(html[data-theme="dark"]) .theme-toggle .moon { display: block; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      const next = isDark ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (_) {}
    });
  });
</script>
