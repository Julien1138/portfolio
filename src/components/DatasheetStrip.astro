---
export interface Field {
  label: string;
  value: string;
}
export interface Props {
  fields: Field[];
}
const { fields } = Astro.props;
---

<div class="strip">
  <div class="container strip-inner">
    {fields.map((f, i) => (
      <>
        {i > 0 && <span class="sep">·</span>}
        <span><span class="muted">{f.label}</span>&nbsp;{f.value}</span>
      </>
    ))}
  </div>
</div>

<style>
  .strip {
    background: var(--strip-bg);
    color: var(--strip-fg);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 11px 0;
    transition: background 200ms ease, color 200ms ease;
  }
  .strip-inner {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }
  .strip span.sep { opacity: 0.4; }
  .strip span.muted { color: var(--strip-muted); }

  @media (max-width: 760px) {
    .strip-inner { flex-wrap: wrap; gap: 8px 16px; }
  }
</style>
