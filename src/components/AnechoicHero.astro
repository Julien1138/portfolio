---
// Stylised anechoic-chamber absorber field, generated at build time
// (deterministic geometry) — no client JS, and no photograph, since the
// programme's own visuals are not publishable. The accent wave is damped
// as it travels into the field: what such a chamber is for.
const rows = 11;
const viewW = 800;
const viewH = 260;

const parts: string[] = [];
for (let r = 0; r < rows; r++) {
  const t = r / (rows - 1);
  const y = 44 + Math.pow(t, 1.55) * 196;
  const w = 13 + t * 34;
  const h = 17 + t * 40;
  const shade = Math.round(26 + t * 30);
  const lightv = Math.round(46 + t * 78);
  const dark = `rgb(${shade},${shade - 2},${Math.round(shade * 0.86)})`;
  const light = `rgb(${lightv},${Math.round(lightv * 0.97)},${Math.round(lightv * 0.86)})`;
  const edge = `rgba(190,180,160,${(0.05 + t * 0.16).toFixed(2)})`;
  const offset = (r % 2) * (w / 2) - w;
  for (let x = offset; x < viewW + 30; x += w) {
    const mid = x + w / 2;
    parts.push(
      `<path d="M${x.toFixed(1)} ${y.toFixed(1)} L${mid.toFixed(1)} ${(y - h).toFixed(1)} L${mid.toFixed(1)} ${y.toFixed(1)} z" fill="${light}"/>`,
      `<path d="M${mid.toFixed(1)} ${y.toFixed(1)} L${mid.toFixed(1)} ${(y - h).toFixed(1)} L${(x + w).toFixed(1)} ${y.toFixed(1)} z" fill="${dark}"/>`,
      `<path d="M${x.toFixed(1)} ${y.toFixed(1)} L${mid.toFixed(1)} ${(y - h).toFixed(1)} L${(x + w).toFixed(1)} ${y.toFixed(1)}" fill="none" stroke="${edge}" stroke-width="0.8"/>`
    );
  }
}

// Three phase-shifted wavefronts, amplitude decaying into the field.
const waves = [
  { phase: 1.8, amp: 26, width: 1.1, op: 0.3 },
  { phase: 0.9, amp: 40, width: 1.4, op: 0.45 },
  { phase: 0, amp: 54, width: 1.9, op: 0.8 },
];
for (const wv of waves) {
  let d = "M0 150";
  for (let x = 0; x <= viewW; x += 8) {
    const decay = Math.exp(-x / 300);
    d += ` L${x} ${(150 + Math.sin(x / 26 + wv.phase) * wv.amp * decay).toFixed(1)}`;
  }
  parts.push(`<path d="${d}" fill="none" stroke="var(--accent)" stroke-width="${wv.width}" opacity="${wv.op}"/>`);
}

const svgInner = parts.join("");
---

<div class="anechoic" aria-hidden="true">
  <span class="corner tl">CHAMBRE ANÉCHOÏQUE</span>
  <span class="corner tr">ILLUSTRATION</span>
  <span class="corner bl">ENVIRONNEMENT ÉLECTROMAGNÉTIQUE</span>
  <span class="corner br">P-04 · THALES LAS</span>
  <svg viewBox={`0 0 ${viewW} ${viewH}`} preserveAspectRatio="xMidYMid slice" set:html={svgInner} />
</div>

<style>
  .anechoic {
    background: var(--led-bg);
    border: 1px solid var(--rule);
    padding: 24px;
    position: relative;
    overflow: hidden;
    min-height: 320px;
    display: flex;
    align-items: center;
  }
  .anechoic svg { display: block; width: 100%; height: auto; }
  .anechoic .corner {
    position: absolute;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--strip-muted);
    opacity: 0.7;
  }
  .anechoic .corner.tl { top: 10px; left: 12px; }
  .anechoic .corner.tr { top: 10px; right: 12px; }
  .anechoic .corner.bl { bottom: 10px; left: 12px; }
  .anechoic .corner.br { bottom: 10px; right: 12px; }
</style>
