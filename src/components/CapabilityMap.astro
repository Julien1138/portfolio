---
export interface Segment {
  from: number;
  to: number;
  label: string;
  style?: "intense" | "outline"; // outline = ponctuel/R&D, intense = projet principal
}
export interface Lane {
  label: string;
  color: string; // css var(--xxx)
  lead?: boolean; // leadership lane renders segments in solid ink/paper instead of color
  segments: Segment[];
}
export interface Props {
  yMin: number;
  yMax: number;
  lanes: Lane[];
}
const { yMin, yMax, lanes } = Astro.props;
const span = yMax - yMin;

function pct(from: number, to: number) {
  const left = ((from - yMin) / span) * 100;
  const width = ((to - from) / span) * 100;
  return { left: `${left}%`, width: `calc(${width}% - 4px)` };
}

const axisYears = [yMin, yMin + Math.round(span * 0.176), yMin + Math.round(span * 0.353), yMin + Math.round(span * 0.529), yMin + Math.round(span * 0.706), yMin + Math.round(span * 0.882), yMax];
---

<figure class="capmapfig">
  <div class="capmap">
    <div class="ph">
      <span class="lbl"><span class="ref">FIG. 01</span> &nbsp; Carte des compétences — {yMin} → {yMax}</span>
      <span class="lbl">{lanes.length} disciplines · {span} ans</span>
    </div>
    <div class="grid">
      {lanes.map((lane, li) => (
        <>
          <div class={`lane-label ${li === lanes.length - 1 ? "last" : ""}`}>
            <span class="dot" style={`background:${lane.color}`}></span>{lane.label}
          </div>
          <div class={`lane-track ${li === lanes.length - 1 ? "last" : ""}`}>
            {lane.segments.map((seg) => {
              const { left, width } = pct(seg.from, seg.to);
              const cls = lane.lead ? (seg.style === "outline" ? "lead-c" : "lead") : seg.style === "intense" ? "intense" : "";
              return (
                <div class={`seg ${cls}`} style={`left:${left}; width:${width}; color:${lane.color}`}>
                  <span>{seg.label}</span>
                </div>
              );
            })}
          </div>
        </>
      ))}
    </div>
    <div class="axis">
      <div class="axis-pad"></div>
      <div class="axis-years">
        {axisYears.map((y, i) => (
          <span class={`y ${y === yMax ? "now" : ""}`} style={`left:${(i / (axisYears.length - 1)) * 100}%`}>{y}</span>
        ))}
      </div>
    </div>
    <div class="legend">
      <span class="item"><span class="sw outline" style="color: var(--accent)"></span>contour : usage ponctuel / R&amp;D</span>
      <span class="item"><span class="sw intense" style="color: var(--accent)"></span>plein : projet principal</span>
      <span class="item"><span class="sw intense" style="color: var(--ink)"></span>noir : rôle de leadership</span>
    </div>
  </div>
  <figcaption class="fig-caption">
    <span class="ref">FIG. 01</span>
    Les disciplines se chevauchent — c'est le point. Personne n'apprend en
    serial : on empile, on relie, on continue.
  </figcaption>
</figure>

<style>
  .capmapfig { margin: 0; }
  .capmap {
    margin: 48px 0 0;
    border: 1px solid var(--rule);
    background: var(--paper-2);
    padding: 24px 24px 22px;
  }
  .capmap .ph { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; }
  .capmap .ph .lbl {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .capmap .ph .ref { color: var(--accent); }

  .capmap .grid { display: grid; grid-template-columns: 130px 1fr; gap: 0; border-top: 1px solid var(--rule); }
  .capmap .lane-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    padding: 14px 14px 14px 0;
    border-bottom: 1px dotted var(--rule);
    border-right: 1px solid var(--rule);
    display: flex; align-items: center; gap: 8px;
  }
  .capmap .lane-label .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .capmap .lane-label.last, .capmap .lane-track.last { border-bottom: none; }

  .capmap .lane-track { position: relative; height: 38px; border-bottom: 1px dotted var(--rule); padding: 0 0 0 16px; }
  .capmap .seg {
    position: absolute;
    top: 8px; bottom: 8px;
    background: var(--paper);
    border: 1px solid currentColor;
    color: var(--ink);
    border-radius: 2px;
    display: flex; align-items: center;
    padding: 0 8px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    overflow: hidden;
  }
  .capmap .seg > span {
    display: block;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .capmap .seg span { color: var(--ink-soft); }
  .capmap .seg.intense { background: currentColor; }
  .capmap .seg.intense > span { color: var(--paper); }
  .capmap .seg.lead { background: var(--ink); border-color: var(--ink); }
  .capmap .seg.lead > span { color: var(--paper); }
  .capmap .seg.lead-c { color: var(--ink); }

  .capmap .axis {
    display: grid;
    grid-template-columns: 130px 1fr;
    border-top: 1.5px solid var(--ink);
    padding-top: 8px;
  }
  .capmap .axis .axis-years {
    position: relative;
    padding: 0 0 0 16px;
    height: 22px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink-soft);
    letter-spacing: 0.08em;
  }
  .capmap .axis .axis-years .y { position: absolute; top: 0; transform: translateX(-50%); }
  .capmap .axis .axis-years .y::before {
    content: "";
    position: absolute;
    left: 50%; top: -8px;
    width: 1px; height: 6px;
    background: var(--ink-soft);
  }
  .capmap .axis .axis-years .y.now { color: var(--accent); font-weight: 600; }
  .capmap .axis .axis-years .y.now::before { background: var(--accent); }

  .capmap .legend {
    margin-top: 18px;
    display: flex; flex-wrap: wrap; gap: 14px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
  }
  .capmap .legend .item { display: flex; align-items: center; gap: 6px; }
  .capmap .legend .item .sw { width: 12px; height: 8px; border: 1px solid currentColor; }
  .capmap .legend .item .sw.intense { background: currentColor; }
  .capmap .legend .item .sw.outline { background: var(--paper); }

  .fig-caption {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
    margin: 8px 0 0;
    display: flex; align-items: baseline; gap: 8px;
  }
  .fig-caption .ref { color: var(--accent); letter-spacing: 0.1em; text-transform: uppercase; }

  @media (max-width: 760px) {
    .capmap .grid, .capmap .axis { grid-template-columns: 88px 1fr; }
    .capmap .lane-label { font-size: 10px; padding-right: 8px; }
  }
</style>
