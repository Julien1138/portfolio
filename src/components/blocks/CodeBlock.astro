---
export interface Props {
  head: string;
  lines: string[]; // trusted inline HTML per line
}
const { head, lines } = Astro.props;
---

<div class="codeblock">
  <div class="head">{head}</div>
  {lines.map((line) => <div class="line" set:html={line} />)}
</div>

<style>
  .codeblock {
    margin-top: 8px;
    max-width: var(--maxw);
    background: var(--code-bg);
    color: var(--code-fg);
    padding: 22px 24px;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.85;
    border: 1px solid var(--rule);
    border-radius: 2px;
    overflow-x: auto;
  }
  .codeblock .head {
    color: var(--code-muted);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule-2);
  }
  .codeblock .line { white-space: pre; }
  .codeblock .line :global(b) { color: var(--code-fg); font-weight: 500; }
  .codeblock .line :global(.com) { color: var(--code-muted); }
  .codeblock .line :global(.ac) { color: var(--code-accent); }
</style>
