---
import MaturityBars from "./MaturityBars.astro";

export interface Usage {
  label: string;
  href?: string;
}
export interface Row {
  id: string;
  family: "FPGA" | "EMB" | "PROTO" | "ELEC" | "CAO" | "BCK" | "FRT" | "INF" | "MTH";
  ref: string;
  detail: string;
  since: number;
  maturity: number;
  usages: Usage[];
}
export interface FamilyMeta {
  code: string;
  title: string;
  meta: string;
}
export interface Props {
  rows: Row[];
  families: FamilyMeta[];
}
const { rows, families } = Astro.props;

const counts = Object.fromEntries(families.map((f) => [f.code, rows.filter((r) => r.family === f.code).length]));
---

<div class="filter-bar">
  <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
    <span class="label">Famille</span>
    <div class="chips" id="filter-chips">
      <button class="chip active" data-fam="all" type="button">all <span class="count">{rows.length}</span></button>
      {families.map((f) => (
        <button class="chip" data-fam={f.code} type="button">
          {f.title.split(" ")[0].toLowerCase()} <span class="count">{counts[f.code]}</span>
        </button>
      ))}
    </div>
  </div>
  <div class="toolbar-right">
    <span class="total"><b id="row-count">{rows.length}</b> / {rows.length} affichées</span>
    <span class="sep">·</span>
    <span class="legend-link" id="scroll-legend">légende ↓</span>
  </div>
</div>

<div class="bom-wrap">
  <table class="bom" id="bom-table">
    <thead>
      <tr>
        <th>Réf.</th>
        <th>Composant</th>
        <th>Maturité</th>
        <th>Usages</th>
      </tr>
    </thead>
    <tbody id="bom-body">
      {families.map((f) => (
        <>
          <tr class="family-row" data-fam-row={f.code}>
            <td colspan="4">
              <span class="fam-prefix">{f.code}</span><span class="fam-title">{f.title}</span><span class="fam-meta">{f.meta}</span>
            </td>
          </tr>
          {rows.filter((r) => r.family === f.code).map((r) => (
            <tr data-fam={f.code}>
              <td class="ref">{r.ref}</td>
              <td class="cat">{r.detail}</td>
              <td class="lvl"><MaturityBars level={r.maturity} /></td>
              <td class="use">
                {r.usages.map((u) => (
                  u.href ? <a class="use-chip" href={u.href}>{u.label}</a> : <span class="use-chip plain">{u.label}</span>
                ))}
              </td>
            </tr>
          ))}
        </>
      ))}
    </tbody>
  </table>
</div>

<div class="legend-grid" id="legend">
  <div class="legend-cell">
    <span class="lk">Maturité — barres</span>
    <div class="lv">
      <div class="row-l"><b><MaturityBars level={1} /></b><span>notions</span></div>
      <div class="row-l"><b><MaturityBars level={2} /></b><span>opérationnel</span></div>
      <div class="row-l"><b><MaturityBars level={3} /></b><span>autonome</span></div>
      <div class="row-l"><b><MaturityBars level={4} /></b><span>senior</span></div>
      <div class="row-l"><b><MaturityBars level={5} /></b><span>autorité</span></div>
    </div>
  </div>
  <div class="legend-cell">
    <span class="lk">Usages</span>
    <div class="lv">
      Où c'est réellement utilisé — <b>lien</b> vers la fiche projet ou rôle
      quand elle existe, sinon <b>client · année</b> en attendant qu'elle
      soit rédigée.
    </div>
  </div>
  <div class="legend-cell">
    <span class="lk">Critères d'inclusion</span>
    <div class="lv">
      Présent en production sur <b>au moins un projet livré</b>, opéré directement
      (pas en supervision lointaine), avec capacité à <em>debugger seul</em> en cas d'incident.
    </div>
  </div>
</div>

<style>
  .filter-bar { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-bottom: 18px; flex-wrap: wrap; }
  .filter-bar .label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 5px 10px;
    border: 1px solid var(--rule-2);
    background: var(--paper);
    color: var(--ink-2);
    border-radius: 2px;
    cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    transition: all 120ms ease;
  }
  .chip:hover { border-color: var(--ink-soft); color: var(--ink); }
  .chip.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  :global(html[data-theme="dark"]) .chip.active { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .chip .count { font-size: 9.5px; color: var(--ink-soft); background: var(--paper-2); padding: 1px 4px; border-radius: 2px; min-width: 16px; text-align: center; }
  .chip.active .count { background: rgba(255,255,255,0.12); color: var(--paper); }
  :global(html[data-theme="dark"]) .chip.active .count { background: rgba(0,0,0,0.15); color: var(--ink); }

  .toolbar-right { display: flex; align-items: center; gap: 12px; font-family: var(--mono); font-size: 11px; color: var(--ink-soft); }
  .toolbar-right .total b { color: var(--ink); font-weight: 500; }
  .toolbar-right .sep { opacity: 0.4; }
  .toolbar-right .legend-link { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--rule-2); cursor: pointer; }
  .toolbar-right .legend-link:hover { color: var(--ink); text-decoration-color: var(--accent); }

  .bom-wrap { border: 1px solid var(--ink); background: var(--paper); }
  table.bom { width: 100%; border-collapse: collapse; font-family: var(--mono); font-size: 12px; }
  table.bom thead th {
    text-align: left;
    padding: 12px 14px;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bom-head-fg);
    background: var(--bom-head-bg);
    font-weight: 500;
    white-space: nowrap;
  }
  table.bom thead th:first-child { padding-left: 18px; }
  table.bom tbody td { padding: 11px 14px; border-bottom: 1px solid var(--rule); vertical-align: middle; }
  table.bom tbody td:first-child { padding-left: 18px; }
  table.bom tbody tr:nth-child(even) td { background: var(--paper-2); }
  table.bom tbody tr:hover td { background: var(--accent-soft); }
  table.bom tbody tr.family-row td {
    background: var(--ink) !important;
    color: var(--paper);
    padding: 10px 18px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 10.5px;
    border-bottom: none;
    border-top: 1.5px solid var(--ink);
  }
  table.bom tbody tr.family-row:first-child td { border-top: none; }
  table.bom tbody tr.family-row .fam-title { color: var(--paper); }
  table.bom tbody tr.family-row .fam-meta { color: var(--strip-muted); font-weight: 400; margin-left: 12px; }
  table.bom tbody tr.family-row .fam-prefix { color: var(--accent); margin-right: 8px; }

  td.ref { color: var(--accent); letter-spacing: 0.08em; white-space: nowrap; }
  td.cat { color: var(--ink); font-weight: 500; font-family: var(--sans); font-size: 13.5px; }
  td.lvl { white-space: nowrap; }
  td.use { display: flex; flex-wrap: wrap; gap: 6px; }

  tr:hover :global(.bars span:not(.off)) { background: var(--accent-2); }

  .use-chip {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    padding: 3px 8px;
    border: 1px solid var(--rule-2);
    background: var(--paper);
    color: var(--ink-2);
    border-radius: 2px;
    white-space: nowrap;
    transition: border-color 150ms ease, color 150ms ease;
  }
  a.use-chip:hover { border-color: var(--accent); color: var(--accent); }
  .use-chip.plain { color: var(--ink-soft); font-style: italic; }

  table.bom tbody tr:last-child td { border-bottom: 1.5px solid var(--ink); }

  .legend-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--rule); margin-top: 28px; background: var(--paper-2); }
  .legend-cell { padding: 18px 22px; border-right: 1px solid var(--rule); }
  .legend-cell:last-child { border-right: none; }
  .legend-cell .lk { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 10px; display: block; }
  .legend-cell .lv { font-family: var(--mono); font-size: 12px; color: var(--ink-2); line-height: 1.7; }
  .legend-cell .lv :global(b) { color: var(--ink); font-weight: 500; }
  .legend-cell .lv :global(em) { font-style: italic; }
  .legend-cell .lv .row-l { display: flex; align-items: center; gap: 10px; }
  .legend-cell .lv .row-l b { min-width: 60px; }

  @media (max-width: 1100px) {
    .legend-grid { grid-template-columns: repeat(2, 1fr); }
    .legend-cell:nth-child(2) { border-right: none; }
    .legend-cell:nth-child(1), .legend-cell:nth-child(2) { border-bottom: 1px solid var(--rule); }
  }
  @media (max-width: 820px) {
    table.bom { font-size: 11px; }
    table.bom thead th:nth-child(3), table.bom tbody td:nth-child(3) { display: none; }
  }
</style>

<script>
  const chipsWrap = document.getElementById("filter-chips");
  const body = document.getElementById("bom-body");
  const counter = document.getElementById("row-count");
  const legendLink = document.getElementById("scroll-legend");

  if (chipsWrap && body) {
    chipsWrap.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-fam]");
      if (!btn) return;
      chipsWrap.querySelectorAll(".chip").forEach((c) => c.classList.remove("active"));
      btn.classList.add("active");
      const fam = btn.dataset.fam || "all";

      const rows = Array.from(body.querySelectorAll<HTMLTableRowElement>("tr[data-fam]"));
      const famRows = Array.from(body.querySelectorAll<HTMLTableRowElement>("tr[data-fam-row]"));
      let visible = 0;
      rows.forEach((r) => {
        const show = fam === "all" || r.dataset.fam === fam;
        r.style.display = show ? "" : "none";
        if (show) visible++;
      });
      famRows.forEach((fr) => {
        fr.style.display = fam === "all" || fr.dataset.famRow === fam ? "" : "none";
      });
      if (counter) counter.textContent = String(visible);
    });
  }

  legendLink?.addEventListener("click", () => {
    document.getElementById("legend")?.scrollIntoView({ behavior: "smooth", block: "center" });
  });
</script>
