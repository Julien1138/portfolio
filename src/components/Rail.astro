---
export interface Props {
  active: number;
}
const { active } = Astro.props;

const items = [
  { num: "01", label: "Index", href: "/" },
  { num: "02", label: "Projets", href: "/projets/" },
  { num: "03", label: "Rôles", href: "/roles/" },
  { num: "04", label: "Parcours", href: "/parcours/" },
  { num: "05", label: "Stack", href: "/stack/" },
  { num: "06", label: "Intérêts", href: "/interets/" },
  { num: "07", label: "Perso", href: "/perso/" },
  { num: "08", label: "Contact", href: "/contact/" },
];
---

<div class="mobile-topbar">
  <div class="mark"><span class="dot"></span>JA.ENG</div>
  <button id="mobile-menu-btn" class="menu-btn" aria-expanded="false" aria-controls="rail" aria-label="Ouvrir le menu">
    <span></span><span></span><span></span>
  </button>
</div>
<div id="rail-overlay" class="rail-overlay"></div>

<aside class="rail" id="rail" aria-label="Navigation">
  <div>
    <div class="mark"><span class="dot"></span>JA.ENG</div>
    <div class="mark-sub">PORTFOLIO · v1.0</div>
  </div>
  <nav>
    {items.map((item, i) => (
      <a href={item.href} class={active === i + 1 ? "active" : ""}>
        <span class="num">{item.num}</span><span>{item.label}</span>
      </a>
    ))}
  </nav>
  <div class="grow"></div>
  <div class="status">
    <div>Septeuil (78) · remote</div>
    <div>maj. 12.05.2026</div>
  </div>
</aside>

<style>
  .rail {
    position: fixed;
    top: 0; left: 0; bottom: 0;
    width: var(--rail);
    border-right: 1px solid var(--rule);
    background: var(--paper);
    padding: 28px 22px 22px;
    display: flex;
    flex-direction: column;
    z-index: 10;
    transition: background 200ms ease, border-color 200ms ease;
  }
  .rail .mark {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .rail .mark .dot {
    width: 8px; height: 8px;
    background: var(--accent);
    border-radius: 50%;
    display: inline-block;
  }
  .rail .mark-sub {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-top: 4px;
  }
  .rail nav {
    margin-top: 56px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .rail nav a {
    display: grid;
    grid-template-columns: 26px 1fr;
    align-items: center;
    padding: 7px 0 7px 10px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    border-left: 2px solid transparent;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
  }
  .rail nav a .num {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-soft);
    letter-spacing: 0.06em;
  }
  .rail nav a:hover { color: var(--ink); }
  .rail nav a.active {
    color: var(--ink);
    border-left-color: var(--accent);
  }
  .rail nav a.active .num { color: var(--accent); }
  .rail .grow { flex: 1; }
  .rail .status {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
    line-height: 1.7;
  }
  .mobile-topbar { display: none; }
  .rail-overlay { display: none; }

  @media (max-width: 760px) {
    .mobile-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 52px;
      padding: 0 18px;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
      z-index: 36;
    }
    .mobile-topbar .mark {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .mobile-topbar .mark .dot {
      width: 8px; height: 8px;
      background: var(--accent);
      border-radius: 50%;
      display: inline-block;
    }
    .menu-btn {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      width: 32px;
      height: 32px;
      padding: 0;
      background: none;
      border: 1px solid var(--rule-2);
      border-radius: 2px;
      cursor: pointer;
    }
    .menu-btn span {
      display: block;
      width: 16px;
      height: 1.5px;
      margin: 0 auto;
      background: var(--ink);
      transition: transform 180ms ease, opacity 180ms ease;
    }
    .menu-btn[aria-expanded="true"] span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
    .menu-btn[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .menu-btn[aria-expanded="true"] span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

    .rail {
      display: flex;
      width: min(78vw, 280px);
      transform: translateX(-100%);
      transition: transform 220ms ease;
      z-index: 40;
    }
    .rail.open { transform: translateX(0); }

    .rail-overlay {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      opacity: 0;
      pointer-events: none;
      transition: opacity 220ms ease;
      z-index: 35;
    }
    .rail-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const rail = document.getElementById("rail");
  const overlay = document.getElementById("rail-overlay");

  function closeMenu() {
    rail?.classList.remove("open");
    overlay?.classList.remove("open");
    btn?.setAttribute("aria-expanded", "false");
  }
  function toggleMenu() {
    const isOpen = rail?.classList.toggle("open");
    overlay?.classList.toggle("open", isOpen);
    btn?.setAttribute("aria-expanded", isOpen ? "true" : "false");
  }

  btn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", closeMenu);
  rail?.querySelectorAll("nav a").forEach((a) => a.addEventListener("click", closeMenu));
</script>
