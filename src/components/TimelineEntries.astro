---
export interface Entry {
  yearRange: string;
  span: string;
  current: boolean;
  roleLine: string;
  title: string;
  setting: string;
  desc: string;
  highlights: { n: string; html: string }[];
  stack: string[];
  links: { label: string; href: string }[];
}
export interface Props {
  entries: Entry[];
}
const { entries } = Astro.props;
---

<div class="timeline">
  {entries.map((e) => (
    <article class="entry">
      <div class="ymark">
        <span class={`y ${e.current ? "cur" : ""}`}>{e.yearRange}</span>
        <span class="span">{e.span}</span>
        {e.current && <span class="badge">En cours</span>}
      </div>
      <div class="body">
        <div class="role-line">{e.roleLine}</div>
        <h3>{e.title}</h3>
        <p class="setting">{e.setting}</p>
        <p class="desc" set:html={e.desc} />
        <ul class="highlights">
          {e.highlights.map((h) => (
            <li><span class="hn">{h.n}</span><span set:html={h.html} /></li>
          ))}
        </ul>
        <div class="stack-line">
          <span class="k">Stack</span>
          {e.stack.map((s) => <span class="chip">{s}</span>)}
        </div>
        {e.links.length > 0 && (
          <div class="fiche-links">
            <span class="k">Détail</span>
            {e.links.map((l) => <a class="fiche-link" href={l.href}>{l.label} →</a>)}
          </div>
        )}
      </div>
    </article>
  ))}
</div>

<style>
  .timeline .entry {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 24px;
    padding: 28px 0 30px;
    border-top: 1px solid var(--rule);
    position: relative;
  }
  .timeline .entry:first-child { border-top: 1.5px solid var(--ink); }
  .timeline .entry:last-child { border-bottom: 1.5px solid var(--ink); }

  .timeline .ymark {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    line-height: 1.45;
    padding-top: 2px;
  }
  .timeline .ymark .y { color: var(--ink); font-weight: 600; font-size: 13px; letter-spacing: 0.04em; }
  .timeline .ymark .y.cur { color: var(--accent); }
  .timeline .ymark .span { display: block; color: var(--ink-soft); margin-top: 4px; font-size: 10px; }
  .timeline .ymark .badge {
    display: inline-block;
    margin-top: 8px;
    background: var(--accent);
    color: var(--paper);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    padding: 3px 8px;
    text-transform: uppercase;
    border-radius: 2px;
  }
  :global(html[data-theme="dark"]) .timeline .ymark .badge { color: var(--ink); }

  .timeline .body .role-line {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .timeline .body h3 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 0 0 4px;
    color: var(--ink);
  }
  .timeline .body .setting {
    font-family: var(--serif);
    font-style: italic;
    font-size: 15px;
    color: var(--ink-3);
    margin: 0 0 12px;
  }
  .timeline .body p.desc {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0 0 14px;
    max-width: 620px;
  }
  .timeline .body p.desc :global(b) { color: var(--ink); font-weight: 600; }
  .timeline .body p.desc :global(em) { font-style: italic; }

  .timeline .body .highlights {
    list-style: none;
    margin: 8px 0 14px;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px dotted var(--rule);
    border-bottom: 1px dotted var(--rule);
  }
  .timeline .body .highlights li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    padding: 8px 0;
    font-family: var(--serif);
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink-2);
    border-bottom: 1px dotted var(--rule);
  }
  .timeline .body .highlights li:last-child { border-bottom: none; }
  .timeline .body .highlights li .hn {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 0.06em;
    padding-top: 3px;
  }
  .timeline .body .highlights li :global(b) { color: var(--ink); font-weight: 600; }

  .timeline .body .stack-line {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-top: 12px;
    align-items: center;
  }
  .timeline .body .stack-line .k {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-right: 4px;
  }
  .timeline .body .stack-line .chip {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 3px 9px;
    border: 1px solid var(--rule-2);
    background: var(--paper);
    color: var(--ink-2);
    border-radius: 2px;
  }

  .timeline .body .fiche-links {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-top: 10px;
    align-items: center;
  }
  .timeline .body .fiche-links .k {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-right: 4px;
  }
  .timeline .body .fiche-link {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    padding: 4px 10px;
    border: 1px solid var(--rule-2);
    background: var(--paper);
    color: var(--accent);
    border-radius: 2px;
    transition: border-color 150ms ease, background 150ms ease;
  }
  .timeline .body .fiche-link:hover { border-color: var(--accent); background: var(--accent-soft); }

  @media (max-width: 760px) {
    .timeline .entry { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
